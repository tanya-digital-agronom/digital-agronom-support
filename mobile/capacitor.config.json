{
  "appId": "ru.digitalagronom.support",
  "appName": "Цифровой Агроном",
  "webDir": "www",
  "backgroundColor": "#F6F7F5",
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#F6F7F5"
  },
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0
    },
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  }
}
